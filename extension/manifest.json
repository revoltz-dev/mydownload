{
  "manifest_version": 3,
  "name": "MyDownload",
  "version": "1.0",
  "description": "Manda os downloads do Chrome para o MyDownload.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "MyDownload", "default_popup": "popup.html" }
}
